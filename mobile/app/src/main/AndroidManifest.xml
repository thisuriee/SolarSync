<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Operator mode scans the prosumer's transaction QR. The feature is
         declared optional so the app still installs on a camera-less device,
         where the scanner explains itself instead of crashing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- The nearby-nodes map asks where the phone is so the API can measure
         from there. Coarse is enough: the search radius is kilometres wide. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".SmartSolarApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmaerSolar"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Identity (M1): login is the entry point; it restores a saved
             session and routes by role. -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.RegisterProsumerActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ProsumerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MyProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.OperatorHomeActivity"
            android:exported="false" />

        <!-- Reservations (M3). Not exported: reachable only from the app's
             own screens after login. -->
        <activity
            android:name=".activities.SlotSearchActivity"
            android:exported="false" />
        <activity
            android:name=".activities.CreateReservationActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ReservationSummaryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MyBookingsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EditReservationActivity"
            android:exported="false" />

        <!-- Microgrid nodes: the nearby map and a node's details. Not
             exported: reachable only from the app's own screens after login. -->
        <activity
            android:name=".activities.NearbyNodesMapActivity"
            android:exported="false"
            android:label="@string/map_title" />
        <activity
            android:name=".activities.NodeListActivity"
            android:exported="false"
            android:label="@string/nodes_title" />
        <activity
            android:name=".activities.NodeDetailActivity"
            android:exported="false"
            android:label="@string/node_detail_title" />

        <activity
            android:name=".activities.QrDisplayActivity"
            android:exported="false"
            android:label="@string/qr_bookings_title"
            android:parentActivityName=".activities.ProsumerHomeActivity" />

        <!-- Fulfilment (M4): the operator's half of the handoff. The scanner
             decodes the token, then the result screen verifies it and finalises
             the transfer. Not exported: reachable only from the operator home. -->
        <activity
            android:name=".activities.QrScannerActivity"
            android:exported="false"
            android:label="@string/scan_title" />
        <activity
            android:name=".activities.VerificationResultActivity"
            android:exported="false"
            android:label="@string/verify_title" />

        <!-- Dashboards and booking history (M4). Read-only views over the
             reservations the server already holds. Not exported: reachable only
             from the prosumer home. -->
        <activity
            android:name=".activities.ProsumerDashboardActivity"
            android:exported="false"
            android:label="@string/dashboard_title"
            android:parentActivityName=".activities.ProsumerHomeActivity" />
        <activity
            android:name=".activities.BookingHistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".activities.ProsumerHomeActivity" />

        <!-- Maps key read from local.properties. An unregistered SHA-1 produces
             a grey map with no error dialog, so every member's debug fingerprint
             must be registered against this key. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>