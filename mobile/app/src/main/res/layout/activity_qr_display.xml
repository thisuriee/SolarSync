<?xml version="1.0" encoding="utf-8"?>
<!--
    QrDisplayActivity — two panels in one screen: the approved bookings list,
    and the QR panel it swaps to once a booking is selected.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_bookings_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/qr_loading" />

        <ListView
            android:id="@+id/bookingList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qrPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_token_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/qr_token_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/qrStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/qr_preparing" />

        <Button
            android:id="@+id/qrBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/qr_back" />
    </LinearLayout>
</FrameLayout>
