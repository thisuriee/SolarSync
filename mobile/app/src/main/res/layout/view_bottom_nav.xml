<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    view_bottom_nav.xml
  Author:  Thisuri
  Created: 2026-10-04
  Purpose: The bottom bar shared by every top-level screen: a hairline and the
           tabs. utils/BottomNav adds it under a screen and fills in the menu
           for the signed-in role, so no screen layout repeats it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.SmartSolar.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
